# Web/REST service (Bun)
ATLAS_PORT=3000
ATLAS_BASE_URL=https://atlas.marsaplatform.com
# demo | wordpress | api | gorun
ATLAS_DATA_MODE=demo
ATLAS_WORDPRESS_URL=https://marsaplatform.com
# Base URL of the Atlas REST API, used when ATLAS_DATA_MODE=api (the Worker's default)
ATLAS_API_URL=https://atlas.marsaplatform.com
# Serve MCP in-process at /mcp (self-hosting / rollback). Off by default; production MCP runs on Cloudflare Workers.
ATLAS_HTTP_MCP=0
# Where /mcp points when the in-process endpoint is off
ATLAS_PUBLIC_MCP_URL=https://atlas.marsaplatform.com/mcp

# Records managed in a GoRun CMS (used by the Marsa origin web service)
ATLAS_DATA_MODE=gorun
ATLAS_GORUN_URL=https://gorun.example.com
ATLAS_GORUN_TOKEN=
